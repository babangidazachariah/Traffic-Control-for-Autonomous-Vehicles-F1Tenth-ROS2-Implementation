# OneCIMTlsMsg.msg

#intersection identification/name in case of intersections that are closely spaced
string junctionid

#Vehicle ID in case of Decentralized Cooperative Intersection Management.
string vehicleid

#The identification of the path that has greenwave
string[] pathids

#Initial time the greenwave traffic ligh signal was assigned
float64 starttime

#the duration of the greenwave
float64 duration

#Intersection Controller provides coordinates of important locations of the intersection such as:
#Each approach leg's stop line
#Each depart leg's safety/Exit point
OneCIMKeypoints[] approachpoints

OneCIMKeypoints[] departpoints

#recommended speed for vehicles
float64 speed

